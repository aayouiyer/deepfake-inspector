# Copy to backend/.env and fill in. Never commit .env.

# local = run models on this machine (default, no token needed)
# api   = use Hugging Face Inference Providers (needs HF_API_TOKEN)
INFERENCE_MODE=local
HF_API_TOKEN=

# Optional overrides
# DF_MODEL_ID=prithivMLmods/Deep-Fake-Detector-v2-Model
# AUDIO_SPOOF_MODEL_ID=MelodyMachine/Deepfake-audio-detection-V2
# CLASSIFIER_MODEL_ID=google/vit-base-patch16-224
# MAX_UPLOAD_MB=15
# PORT=5001  (not 5000: macOS AirPlay Receiver uses it)
# FLASK_DEBUG=0
# Comma-separated origins allowed to call the API from another site (blank = same-origin only)
# ALLOWED_ORIGINS=
